<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Blog Views Milestone</title>
  <style>
    body {
      margin: 0;
      padding: 0;
      background-color: #f4f6f8;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;
    }

    .outer-wrapper {
      width: 100%;
      padding: 40px 12px;
    }

    .email-container {
      max-width: 560px;
      margin: 0 auto;
      background-color: #ffffff;
      border: 1px solid #e3e4e8;
      border-radius: 10px;
      overflow: hidden;
      box-shadow: 0 4px 18px rgba(0, 0, 0, 0.05);
    }

    .header {
      background: linear-gradient(135deg, #1a73e8, #4facfe);
      color: #ffffff;
      padding: 24px 28px;
      font-size: 20px;
      font-weight: 600;
    }

    .content {
      padding: 28px;
      color: #404041;
      font-size: 15px;
      line-height: 1.6;
    }

    .content p {
      margin: 0 0 16px;
    }

    .highlight {
      font-weight: 600;
      color: #1a73e8;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin: 20px 0;
      background-color: #fafbfc;
      font-size: 14px;
    }

    th, td {
      border: 1px solid #e3e4e8;
      padding: 12px;
      text-align: left;
    }

    th {
      background-color: #f1f3f5;
      font-weight: 600;
      color: #222;
      width: 35%;
    }

    td {
      color: #333;
    }

    .footer {
      background-color: #f9fafb;
      border-top: 1px solid #e3e4e8;
      padding: 18px 28px;
      font-size: 13px;
      color: #6b7280;
      text-align: center;
    }
  </style>
</head>

<body>
  <div class="outer-wrapper">
    <div class="email-container">

      <div class="header">
        Blog View Milestone Reached
      </div>

      <div class="content">
        <p>
          Hi <strong><%= user.name %></strong>,
        </p>

        <p>
          Congratulations 🎉! One of your blogs has reached an important readership milestone.
          Here are the details:
        </p>

        <table>
            <tr>
                <th>Blog Title</th>
                <td><%= blog.title %></td>
            </tr>
            <tr>
                <th>Total Views</th>
                <td class="highlight"><%= blog.impression %></td>
            </tr>
            <tr>
                <th>Tags</th>
                <td>
                    <% if (blog.tags && blog.tags.length) { %>
                    <%= blog.tags.join(', ') %>
                    <% } else { %>
                    <em>No tags</em>
                    <% } %>
                </td>
            </tr>
            <tr>
                <th>Last Updated</th>
                <td><%= blog.updatedAt ? (new Date(blog.updatedAt)).toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' }) : 'N/A' %></td>
            </tr>
            <tr>
                <th>Created On</th>
                <td><%= blog.createdAt ? (new Date(blog.createdAt)).toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' }) : 'N/A' %></td>
            </tr>
            <tr>
                <th>Action</th>
                <td><a href="<%= process.env.FRONTEND_URL %>/blog/<%= blog.slug %>">View Blog</a></td>
            </tr>
        </table>

        <p>
          Keep publishing great content — your audience is growing 🚀
        </p>
      </div>

      <div class="footer">
        This is an automated notification.  
        Please do not reply to this email.
      </div>

    </div>
  </div>
</body>
</html>
