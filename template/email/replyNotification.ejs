<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>New Reply to Your Comment</title>
  <style>
    body {
      font-family: 'Arial', 'Helvetica', sans-serif;
      line-height: 1.6;
      color: #333;
      background-color: #f4f4f4;
      margin: 0;
      padding: 0;
    }
    .email-container {
      max-width: 600px;
      margin: 20px auto;
      background: #ffffff;
      border-radius: 10px;
      overflow: hidden;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }
    .header {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      padding: 40px 20px;
      text-align: center;
    }
    .header h1 {
      margin: 0;
      font-size: 28px;
      font-weight: bold;
    }
    .header p {
      margin: 10px 0 0;
      font-size: 16px;
      opacity: 0.9;
    }
    .content {
      padding: 40px 30px;
    }
    .notice-box {
      background: #f8f9fa;
      border-left: 4px solid #667eea;
      padding: 20px;
      margin: 20px 0;
      border-radius: 5px;
    }
    .notice-box h2 {
      margin: 0 0 10px;
      color: #667eea;
      font-size: 20px;
    }
    .quote-box {
      background: #f8f9fa;
      border-left: 4px solid #dee2e6;
      padding: 16px;
      margin: 20px 0;
      border-radius: 5px;
      color: #495057;
    }
    .cta-button {
      display: inline-block;
      padding: 15px 30px;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      text-decoration: none;
      border-radius: 5px;
      font-weight: bold;
      margin: 20px 0;
      text-align: center;
    }
    .footer {
      background: #2c3e50;
      color: white;
      padding: 30px;
      text-align: center;
      font-size: 14px;
    }
    .footer p {
      margin: 5px 0;
    }
  </style>
</head>
<body>
  <div class="email-container">
    <div class="header">
      <h1>New Reply Alert</h1>
      <p>Someone replied to your comment</p>
    </div>

    <div class="content">
      <p>Hello <strong><%= recipientName %></strong>,</p>

      <div class="notice-box">
        <h2><%= replyAuthor %> replied to your comment</h2>
        <p>On blog: <strong><%= blogTitle %></strong></p>
      </div>

      <p><strong>Reply preview:</strong></p>
      <div class="quote-box">
        <%= safeReply %>
      </div>

      <div style="text-align: center;">
        <a href="<%= blogUrl %>" class="cta-button">View Discussion</a>
      </div>
    </div>

    <div class="footer">
      <p><strong>Meowwdium Notifications</strong></p>
      <p style="margin-top: 10px; opacity: 0.8;">
        © <%= new Date().getFullYear() %> Meowwdium. All rights reserved.
      </p>
    </div>
  </div>
</body>
</html>
