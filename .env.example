# MongoDB Connection String
# For local MongoDB: mongodb://localhost:27017/blog_db
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/blog_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/blog_db

# Server Port
PORT=3000

# Environment (development, production)
NODE_ENV=development

# Pagination
PAGINATION_LIMIT=20

# Rate Limiting
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000

# Email sent on every X views reached
BLOG_VIEWS_EMAIL_THRESHOLD=100

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

#EMAIL Configuration
EMAIL_FROM=no-reply@Meowwdium.com
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_HOST_USER=username
EMAIL_HOST_PASSWORD=password
EMAIL_PORT=2525

FRONTEND_URL=http://192.168.9.167:3000

# Moderation LLM provider: openai, groq, gemini
LLM_PROVIDER=openai

# Optional global model override used by adapters
LLM_MODEL=

# Preferred provider-specific API keys
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Backward-compatible generic key fallback (if provider-specific key is not set)
LLM_API_KEY=

# Optional provider-specific model overrides
OPENAI_MODEL=gpt-4o-mini
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_MODEL=gemini-1.5-flash

# Moderation payload length limits
MODERATION_TITLE_MAX=250
MODERATION_DESCRIPTION_MAX=700
MODERATION_CONTENT_SNIPPET_MAX=1400

APP_NAME=Meowwdium
