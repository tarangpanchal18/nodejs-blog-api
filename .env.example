# MongoDB Connection String
# For local MongoDB: mongodb://localhost:27017/blog_db
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/blog_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/blog_db

# Server Port
PORT=3000

# Environment (development, production)
NODE_ENV=development

# Pagination
PAGINATION_LIMIT=10

# Rate Limiting
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000

# Email sent on every X views reached
BLOG_VIEWS_EMAIL_THRESHOLD=10

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
